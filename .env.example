# ARGUS binds locally and starts in review-only mode. Never put passwords,
# private keys, database files, or real candidate answers in this template.
ARGUS_HOST=127.0.0.1
ARGUS_PORT=8787
ARGUS_DATA_DIR=
# OFF | REVIEW_ONLY | ARMED | RUNNING. REVIEW_ONLY is the safe default.
ARGUS_AUTOMATION_MODE=REVIEW_ONLY
# Legacy compatibility opt-in when ARGUS_AUTOMATION_MODE is not set.
ARGUS_ENABLE_LIVE_SUBMIT=false
# Comma-separated hostnames only. Bare entries are exact; use an explicit
# *.example.com entry when intentional subdomain matching is required.
ARGUS_LIVE_DOMAIN_ALLOWLIST=
# Live Trackr discovery is independent and remains opt-in.
ARGUS_ENABLE_TRACKR_LIVE=false
ARGUS_API_TOKEN=
ARGUS_OLLAMA_URL=http://127.0.0.1:11434
ARGUS_OLLAMA_MODEL=
ARGUS_BROWSER_HEADLESS=true
# Default-on consequence classification for requests the route guard already
# blocks during PREFILL. Set false only to restore the legacy all-blocks-fatal
# handoff behavior; it never changes which hosts or requests are reachable.
ARGUS_ENABLE_EGRESS_IMPACT_CLASSIFICATION=true
# Human-attention notifications remain off unless explicitly enabled.
ARGUS_ENABLE_NOTIFICATIONS=false
ARGUS_NTFY_TOPIC=
ARGUS_NTFY_SERVER=https://ntfy.sh
ARGUS_NOTIFY_WEBHOOK_URL=
# To use an existing local Hermes channel, uncomment one exact supported target:
# telegram | slack | signal | discord. Do not define this variable as empty.
# ARGUS_HERMES_NOTIFY_TARGET=telegram
# ARGUS_HERMES_BIN=hermes
ARGUS_NOTIFY_BATCH_WINDOW_SECONDS=30
ARGUS_NOTIFY_RATE_LIMIT_PER_HOUR=6
